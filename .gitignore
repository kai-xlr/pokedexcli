# Pokédex CLI - Go Project .gitignore
# This file specifies intentionally untracked files that Git should ignore.
# See: https://git-scm.com/docs/gitignore

# =============================================================================
# GO-SPECIFIC IGNORES
# =============================================================================

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
*.html

# Go coverage files
coverage.txt
coverage.out
profile.out

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Built binaries
pokedexcli
pokedex-cli
/bin/
/build/
/dist/

# Build artifacts
*.prof
*.cpu
*.mem

# =============================================================================
# IDE AND EDITOR FILES
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~

# GoLand
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# =============================================================================
# APPLICATION-SPECIFIC IGNORES
# =============================================================================

# Logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.envrc

# Configuration files (if they contain secrets)
config.json
config.yaml
config.yml
*.secret
*.key
*.pem
*.crt
*.p12

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp
*.temp
repl.log

# Archive files
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# Benchmark results
benchmark.txt
bench.out

# Air live reload tool
.air.toml
tmp/

# Delve debugger
__debug_bin

# Local development
.local/
local.go
*_local.go

# Documentation build
docs/build/
site/

# =============================================================================
# PROJECT-SPECIFIC PATTERNS
# =============================================================================

# Add any project-specific ignore patterns here
